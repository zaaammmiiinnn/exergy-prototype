# Exergy Solutions Environment Variables

# Supabase (Auth, Postgres, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email Delivery
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=contact@exergy-solutions.com

# Notification Recipients (Default Founder/Admin)
ADMIN_NOTIFY_EMAILS=neuralwaves.official@gmail.com,support@neuralwaves.in

# Cloudflare Turnstile Spam Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Site & Chat Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CHAT_SESSION_SALT=exergy-solutions-chat-salt-replace-in-production

# External Integrations
NEXT_PUBLIC_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...
NEXT_PUBLIC_GA_ID=
